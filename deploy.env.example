# Deploy Configuration Example
# Copy this file to a private path outside the repository (e.g. ~/.config/enkeep/deploy.env)
# or specify via --env-file / command line arguments.
# Do NOT commit real paths or sensitive deployment details into the repository.

# Release metadata
RELEASE_ID=batchNN
TARGET_REF=origin/main

# File system paths (Required, specify valid paths for your host)
WORKSPACE_ROOT=/path/to/workspace
REPO_ROOT=/path/to/workspace/enkeep
RELEASE_ROOT=/path/to/workspace/reports/release-worktrees
DATA_DIR=/path/to/workspace/enkeep/.demo-data
CONFIG_DIR=/path/to/.config/enkeep

# Service & Daemon parameters
PORT=3900
LAUNCHD_LABEL=com.owner-user.enkeep
PLIST_PATH=/path/to/Library/LaunchAgents/com.owner-user.enkeep.plist

# Docker & Container Runtime
RUNTIME_IMAGE_PREFIX=enkeep-runtime:gap-
DOCKERFILE_PATH=docker/Dockerfile.runtime

# Safety & Preflight Timeout
PREFLIGHT_TIMEOUT_SECONDS=7200
PREFLIGHT_INTERVAL_SECONDS=10
PREFLIGHT_DUE_MINUTES=10
KEEP_WORKTREES=3
