{
  "name": "@enkeep/web-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:contract": "vitest run",
    "test:browser": "vitest run tests/contract/contract-browser-*.test.ts",
    "test:docker": "ENKEEP_DOCKER_ACCEPTANCE=1 RUN_DOCKER_TESTS=1 vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@enkeep/demo-runner": "workspace:*",
    "@enkeep/platform-auth": "workspace:*",
    "@enkeep/platform-core": "workspace:*",
    "@enkeep/platform-server": "workspace:*",
    "@enkeep/platform-storage-sqlite": "workspace:*",
    "@enkeep/protocol": "workspace:*",
    "@enkeep/runtime-runner": "workspace:*",
    "@enkeep/web-channel": "workspace:*",
    "@enkeep/web-ui": "workspace:*",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  }
}
