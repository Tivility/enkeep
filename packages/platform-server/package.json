{
  "name": "@enkeep/platform-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./storage/session-event-parser": {
      "types": "./src/storage/session-event-parser.ts",
      "import": "./dist/storage/session-event-parser.js",
      "default": "./dist/storage/session-event-parser.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:migration-v2": "vitest run tests/migration-v2-service-and-routes.test.ts"
  },
  "dependencies": {
    "@enkeep/backup-restore": "workspace:*",
    "@enkeep/channel-lark": "workspace:*",
    "@enkeep/dsh-enkeep-bundle": "workspace:*",
    "@enkeep/dsh-external-interaction": "workspace:*",
    "@enkeep/import-happyclaw": "workspace:*",
    "@enkeep/platform-auth": "workspace:*",
    "@enkeep/platform-core": "workspace:*",
    "@enkeep/platform-operations": "workspace:*",
    "@enkeep/platform-storage-sqlite": "workspace:*",
    "@enkeep/protocol": "workspace:*",
    "@enkeep/web-channel": "workspace:*",
    "@enkeep/web-ui": "workspace:*",
    "busboy": "^1.6.0",
    "cron-parser": "^5.10.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  }
}
