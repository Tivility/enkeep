{
  "name": "@enkeep/runtime-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./spec": {
      "types": "./src/spec/index.ts",
      "import": "./dist/spec/index.js",
      "default": "./dist/spec/index.js"
    },
    "./transport": {
      "types": "./src/transport/index.ts",
      "import": "./dist/transport/index.js",
      "default": "./dist/transport/index.js"
    },
    "./docker": {
      "types": "./src/docker/index.ts",
      "import": "./dist/docker/index.js",
      "default": "./dist/docker/index.js"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./tunnel": {
      "types": "./src/tunnel/index.ts",
      "import": "./dist/tunnel/index.js",
      "default": "./dist/tunnel/index.js"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "import": "./dist/host/index.js",
      "default": "./dist/host/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:docker": "ENKEEP_DOCKER_ACCEPTANCE=1 vitest run tests/docker-optin.e2e.test.ts tests/daemon-docker-topology.e2e.test.ts --no-file-parallelism"
  },
