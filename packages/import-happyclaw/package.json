{
  "name": "@enkeep/import-happyclaw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "bin": {
    "enkeep-import-happyclaw": "./dist/cli.js",
    "hpc-migrate": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.config.ts",
    "test:migration-v2": "vitest run -c vitest.config.ts tests/migration-v2.test.ts",
    "fixtures:generate": "node --experimental-strip-types fixtures/generate-fixtures.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-session": "0.1.2-rc.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  }
}
